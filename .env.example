# AI API (api.hcnsec.cn)
HCNSEC_API_KEY=your_hcnsec_api_key_here
HCNSEC_BASE_URL=https://api.hcnsec.cn/v1

# Supabase (dari Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# NextAuth (opsional, untuk session)
NEXTAUTH_SECRET=change-me-to-a-random-string

# OCR otomatis untuk screenshot YouTube Studio (opsional tapi disarankan)
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# YouTube Analytics resmi (read-only OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
YT_OAUTH_COOKIE_SECRET=change-me-to-a-long-random-secret
# Optional kalau domain callback tidak otomatis benar:
# YT_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/youtube/oauth/callback

# Opsional: API riset eksternal dari daftar API_TARGETS.md (jangan dipakai tanpa guard/rate limit)
APIFY_TOKEN=your_apify_token_here
